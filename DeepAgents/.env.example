# API Keys
# Get a Tavily API key from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# Get a Google AI Studio API key from https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here

# Optional: LangChain Tracing (LangSmith)
# Sign up at https://smith.langchain.com/
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langchain_api_key_here
# LANGCHAIN_PROJECT=DeepAgents

# Observability (OpenTelemetry / AI Toolkit)
# Default is localhost:4318 for VS Code AI Toolkit
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"
