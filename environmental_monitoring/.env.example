# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/environmental_monitoring

# Redis Cache Configuration (optional)
REDIS_URL=redis://localhost:6379

# Moltbook Integration
MOLTBOOK_API_KEY=your_moltbook_api_key_here
MOLTBOOK_AGENT_NAME=EnvironmentalMonitor

# Email Configuration (for alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# Slack Configuration (for team alerts)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/environmental_monitoring.log

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Security
SECRET_KEY=your_secret_key_here
API_KEY_EXPIRY_HOURS=24

# ML Model Configuration
MODEL_UPDATE_INTERVAL_HOURS=24
ANOMALY_THRESHOLD=0.95
PREDICTION_HORIZON_HOURS=24

# GIS Configuration
DEFAULT_CRS=EPSG:4326
MAP_ZOOM_LEVEL=10

# Alert Configuration
ALERT_RETRY_ATTEMPTS=3
ALERT_RETRY_DELAY_SECONDS=60
ALERT_ESCALATION_TIME_MINUTES=30

# Sensor Configuration
SENSOR_POLLING_INTERVAL_SECONDS=300
SENSOR_TIMEOUT_SECONDS=30
SENSOR_MAX_RETRIES=3

# External API Keys (for sensor data)
OPENWEATHER_API_KEY=your_openweather_api_key
AIRNOW_API_KEY=your_airnow_api_key
EPA_API_KEY=your_epa_api_key